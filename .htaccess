# پلتفرم کارت ویزیت مجازی
Options -Indexes

<IfModule mod_rewrite.c>
  RewriteEngine On

  # ۱) اول از همه: مسدود کردن دسترسی مستقیم به پوشه‌های حساس و فایل‌های پنهان
  RewriteRule ^(includes|app)(/|$) - [F,L]
  RewriteRule ^\. - [F,L]
  RewriteRule \.(sql|md|log)$ - [F,L]

  # ۲) فایل‌ها و پوشه‌های واقعی (assets/ ، uploads/ و ...) مستقیم سرو شوند
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # ۳) بقیه‌ی مسیرها به index.php (مسیریاب) بروند
  RewriteRule ^ index.php [L]
</IfModule>

<FilesMatch "^\\.htaccess">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>
